generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  MANAGER
}

model User {
  id          String   @id @db.Uuid
  firebaseUid String   @unique
  email       String?  @unique
  displayName String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

model RoleChange {
  id        String   @id @db.Uuid
  accountId String
  fromRole  Role
  toRole    Role
  operator  String
  changedAt DateTime @default(now()) @db.Timestamptz(3)
}
