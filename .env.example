# Copy to .env and fill in real values; .env is never committed.
# Variables and their meaning: design §8 of change p0-foundation.

# API (apps/api) and the migrate service
DATABASE_URL=postgresql://hms:change-me@localhost:5432/hms
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=4000

# Database container (db)
POSTGRES_USER=hms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hms

# Frontends (web-guest, web-admin), read at build time
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
